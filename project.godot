;   param=value ; assign values to parameters

config_version=5

[application]

config/name="carck-the-cookie"
run/main_scene="uid://bmk4vui5ncr8b"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*uid://p5qbtjyd13vx"

[display]

window/size/viewport_width=90
window/size/viewport_height=160
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[file_customization]

